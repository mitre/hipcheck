        "name": "source-tag-mismatch",
        "publisher": "mitre",
        "version": "0.1.0",
        "query": "source_tag_mismatch"
      },
      "policy": {
        "expression": "plugin.source_tag_mismatch == PASS"
      },
      "state": "unsupported",
      "effect": "missing-check",
      "summary": "source target is unsupported",
      "value": null,
      "error": {
        "kind": "target-resolution",
        "message": "source tag is unavailable",
        "retryable": false
      }
    }
