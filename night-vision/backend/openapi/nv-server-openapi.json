{
  "openapi": "3.0.3",
  "info": {
    "title": "Night Vision",
    "version": "0.1.0"
  },
  "paths": {
    "/assessments": {
      "post": {
        "operationId": "post_assessment",
        "requestBody": {
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "successfully enqueued operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostAssessmentResponse"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/assessments/{id}": {
      "get": {
        "operationId": "get_assessment",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentStatus"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/assessments/{id}/evidence": {
      "get": {
        "operationId": "get_assessment_evidence",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "in": "query",
            "name": "includeRawHipcheck",
            "schema": {
              "nullable": true,
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentEvidence"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/package-sources": {
      "post": {
        "operationId": "post_package_source",
        "requestBody": {
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "successfully enqueued operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostPackageSourceResponse"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/package-sources/{id}": {
      "get": {
        "operationId": "get_package_source",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PackageSourceStatus"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssessmentCheck": {
        "type": "object",
        "properties": {
          "effect": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "effect",
          "state",
          "summary"
        ]
      },
      "AssessmentEvidence": {
        "type": "object",
        "properties": {
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssessmentCheck"
            }
          },
          "findings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssessmentFinding"
            }
          },
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "rawHipcheck": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "checks",
          "findings",
          "id"
        ]
      },
      "AssessmentFinding": {
        "type": "object",
        "properties": {
          "effect": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "severity": {
            "nullable": true,
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "effect",
          "kind",
          "summary"
        ]
      },
      "AssessmentStatus": {
        "type": "object",
        "properties": {
          "errorKind": {
            "nullable": true,
            "type": "string"
          },
          "findingCount": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          },
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "recommendation": {
            "nullable": true,
            "type": "string"
          },
          "retryable": {
            "nullable": true,
            "type": "boolean"
          },
          "state": {
            "type": "string"
          },
          "target": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "findingCount",
          "id",
          "state"
        ]
      },
      "CveIngestHealth": {
        "type": "object",
        "properties": {
          "latestRun": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/CveListSyncRunHealth"
              }
            ]
          },
          "latestSuccessfulCommit": {
            "nullable": true,
            "type": "string"
          },
          "recordsAvailable": {
            "type": "boolean"
          }
        },
        "required": [
          "recordsAvailable"
        ]
      },
      "CveListSyncRunHealth": {
        "type": "object",
        "properties": {
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "nullable": true,
            "type": "string",
            "format": "date-time"
          },
          "error": {
            "nullable": true,
            "type": "string"
          },
          "generation": {
            "type": "integer",
            "format": "int64"
          },
          "recordsInserted": {
            "type": "integer",
            "format": "int32"
          },
          "recordsSeen": {
            "type": "integer",
            "format": "int32"
          },
          "recordsUpdated": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "checkedAt",
          "generation",
          "recordsInserted",
          "recordsSeen",
          "recordsUpdated",
          "status"
        ]
      },
      "Error": {
        "description": "Error information from a response.",
        "type": "object",
        "properties": {
          "error_code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "message",
          "request_id"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "cveIngest": {
            "$ref": "#/components/schemas/CveIngestHealth"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "cveIngest",
          "status"
        ]
      },
      "PackageSource": {
        "type": "object",
        "properties": {
          "contents": {
            "type": "string"
          },
          "ecosystem": {
            "$ref": "#/components/schemas/PackageSourceEcosystem"
          },
          "fileName": {
            "type": "string"
          }
        },
        "required": [
          "contents",
          "ecosystem",
          "fileName"
        ]
      },
      "PackageSourceEcosystem": {
        "type": "string",
        "enum": [
          "npm"
        ]
      },
      "PackageSourceStatus": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "status": {
                "type": "string",
                "enum": [
                  "processing"
                ]
              }
            },
            "required": [
              "createdAt",
              "id",
              "status"
            ]
          },
          {
            "type": "object",
            "properties": {
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "source": {
                "$ref": "#/components/schemas/PackageSource"
              },
              "status": {
                "type": "string",
                "enum": [
                  "completed"
                ]
              },
              "versionedPackages": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/VersionedPackage"
                }
              }
            },
            "required": [
              "createdAt",
              "id",
              "source",
              "status",
              "versionedPackages"
            ]
          },
          {
            "type": "object",
            "properties": {
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "source": {
                "$ref": "#/components/schemas/PackageSource"
              },
              "status": {
                "type": "string",
                "enum": [
                  "completed-with-warnings"
                ]
              },
              "versionedPackages": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/VersionedPackage"
                }
              },
              "warnings": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/PackageSourceWarning"
                }
              },
              "warningsTruncated": {
                "type": "boolean"
              }
            },
            "required": [
              "createdAt",
              "id",
              "source",
              "status",
              "versionedPackages",
              "warnings",
              "warningsTruncated"
            ]
          },
          {
            "type": "object",
            "properties": {
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "diagnostic": {
                "type": "string"
              },
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "previousVersionedPackages": {
                "description": "The last successfully published reachable-version snapshot, if any.\n\nA failed re-elaboration does not replace the prior snapshot, so callers can continue to inspect it while acting on `diagnostic`.",
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/VersionedPackage"
                }
              },
              "status": {
                "type": "string",
                "enum": [
                  "failed"
                ]
              }
            },
            "required": [
              "createdAt",
              "diagnostic",
              "id",
              "previousVersionedPackages",
              "status"
            ]
          }
        ]
      },
      "PackageSourceWarning": {
        "type": "object",
        "properties": {
          "declaredByPurl": {
            "nullable": true,
            "type": "string"
          },
          "dependencyName": {
            "type": "string"
          },
          "message": {
            "description": "A fixed explanation that does not include untrusted registry content.",
            "type": "string"
          },
          "specificationKind": {
            "type": "string"
          }
        },
        "required": [
          "dependencyName",
          "message",
          "specificationKind"
        ]
      },
      "PostAssessmentResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "id"
        ]
      },
      "PostPackageSourceResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id"
        ]
      },
      "VersionedPackage": {
        "type": "object",
        "properties": {
          "derivations": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "ecosystem": {
            "$ref": "#/components/schemas/PackageSourceEcosystem"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "purl": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "derivations",
          "ecosystem",
          "id",
          "name",
          "purl",
          "version"
        ]
      }
    },
    "responses": {
      "Error": {
        "description": "Error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
