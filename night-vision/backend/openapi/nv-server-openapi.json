{
  "openapi": "3.0.3",
  "info": {
    "title": "Night Vision",
    "version": "0.1.0"
  },
  "paths": {
    "/assessments": {
      "post": {
        "operationId": "post_assessment",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostAssessmentBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "successfully enqueued operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostAssessmentResponse"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/assessments/{id}": {
      "get": {
        "operationId": "get_assessment",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentStatus"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/assessments/{id}/evidence": {
      "get": {
        "operationId": "get_assessment_evidence",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "query",
            "name": "includeRawHipcheck",
            "schema": {
              "nullable": true,
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentEvidence"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/health/diagnostics": {
      "get": {
        "operationId": "health_diagnostics",
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthDiagnostics"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/package-sources": {
      "post": {
        "operationId": "post_package_source",
        "requestBody": {
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "successfully enqueued operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostPackageSourceResponse"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/package-sources/{id}": {
      "get": {
        "operationId": "get_package_source",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PackageSourceStatus"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/upgrade-assessments": {
      "post": {
        "operationId": "post_upgrade_assessment",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostUpgradeAssessmentBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "successfully enqueued operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostUpgradeAssessmentResponse"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/upgrade-assessments/{id}": {
      "get": {
        "operationId": "get_upgrade_assessment",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpgradeAssessmentStatus"
                }
              }
            }
          },
          "4XX": {
            "$ref": "#/components/responses/Error"
          },
          "5XX": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssessmentCheck": {
        "type": "object",
        "properties": {
          "effect": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "effect",
          "state",
          "summary"
        ]
      },
      "AssessmentDiagnostics": {
        "type": "object",
        "properties": {
          "errorKind": {
            "nullable": true,
            "type": "string"
          },
          "errorMessage": {
            "nullable": true,
            "type": "string"
          },
          "exitStatus": {
            "nullable": true,
            "type": "integer",
            "format": "int32"
          },
          "retryable": {
            "nullable": true,
            "type": "boolean"
          },
          "sourceRepositoryUrl": {
            "nullable": true,
            "type": "string"
          },
          "stderr": {
            "nullable": true,
            "type": "string"
          },
          "stderrTruncated": {
            "type": "boolean"
          },
          "stdout": {
            "nullable": true,
            "type": "string"
          },
          "stdoutTruncated": {
            "type": "boolean"
          }
        },
        "required": [
          "stderrTruncated",
          "stdoutTruncated"
        ]
      },
      "AssessmentEvidence": {
        "type": "object",
        "properties": {
          "affectedPurl": {
            "nullable": true,
            "type": "string"
          },
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssessmentCheck"
            }
          },
          "diagnostics": {
            "$ref": "#/components/schemas/AssessmentDiagnostics"
          },
          "findings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssessmentFinding"
            }
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "rawHipcheck": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "checks",
          "diagnostics",
          "findings",
          "id"
        ]
      },
      "AssessmentFinding": {
        "type": "object",
        "properties": {
          "effect": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "severity": {
            "nullable": true,
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "effect",
          "kind",
          "summary"
        ]
      },
      "AssessmentStatus": {
        "type": "object",
        "properties": {
          "affectedPurl": {
            "nullable": true,
            "type": "string"
          },
          "errorKind": {
            "nullable": true,
            "type": "string"
          },
          "errorMessage": {
            "nullable": true,
            "type": "string"
          },
          "exitStatus": {
            "nullable": true,
            "type": "integer",
            "format": "int32"
          },
          "findingCount": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "recommendation": {
            "nullable": true,
            "type": "string"
          },
          "retryable": {
            "nullable": true,
            "type": "boolean"
          },
          "sourceRepositoryUrl": {
            "nullable": true,
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "target": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "findingCount",
          "id",
          "state"
        ]
      },
      "CveIngestHealth": {
        "type": "object",
        "properties": {
          "latestRun": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/CveListSyncRunHealth"
              }
            ]
          },
          "latestSuccessfulCommit": {
            "nullable": true,
            "type": "string"
          },
          "recordsAvailable": {
            "type": "boolean"
          }
        },
        "required": [
          "recordsAvailable"
        ]
      },
      "CveListSyncRunHealth": {
        "type": "object",
        "properties": {
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "nullable": true,
            "type": "string",
            "format": "date-time"
          },
          "error": {
            "nullable": true,
            "type": "string"
          },
          "generation": {
            "type": "integer",
            "format": "int64"
          },
          "recordsInserted": {
            "type": "integer",
            "format": "int32"
          },
          "recordsSeen": {
            "type": "integer",
            "format": "int32"
          },
          "recordsUpdated": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "checkedAt",
          "generation",
          "recordsInserted",
          "recordsSeen",
          "recordsUpdated",
          "status"
        ]
      },
      "Error": {
        "description": "Error information from a response.",
        "type": "object",
        "properties": {
          "error_code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "message",
          "request_id"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "HealthDiagnostics": {
        "description": "Health information for operators, not untrusted API callers.",
        "type": "object",
        "properties": {
          "cveIngest": {
            "$ref": "#/components/schemas/CveIngestHealth"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "cveIngest",
          "status"
        ]
      },
      "PackageSource": {
        "type": "object",
        "properties": {
          "contents": {
            "type": "string"
          },
          "ecosystem": {
            "$ref": "#/components/schemas/PackageSourceEcosystem"
          },
          "fileName": {
            "type": "string"
          }
        },
        "required": [
          "contents",
          "ecosystem",
          "fileName"
        ]
      },
      "PackageSourceEcosystem": {
        "type": "string",
        "enum": [
          "npm"
        ]
      },
      "PackageSourceStatus": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "status": {
                "type": "string",
                "enum": [
                  "processing"
                ]
              }
            },
            "required": [
              "createdAt",
              "id",
              "status"
            ]
          },
          {
            "type": "object",
            "properties": {
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "source": {
                "$ref": "#/components/schemas/PackageSource"
              },
              "status": {
                "type": "string",
                "enum": [
                  "completed"
                ]
              },
              "versionedPackages": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/VersionedPackage"
                }
              }
            },
            "required": [
              "createdAt",
              "id",
              "source",
              "status",
              "versionedPackages"
            ]
          },
          {
            "type": "object",
            "properties": {
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "source": {
                "$ref": "#/components/schemas/PackageSource"
              },
              "status": {
                "type": "string",
                "enum": [
                  "completed-with-warnings"
                ]
              },
              "versionedPackages": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/VersionedPackage"
                }
              },
              "warnings": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/PackageSourceWarning"
                }
              },
              "warningsTruncated": {
                "type": "boolean"
              }
            },
            "required": [
              "createdAt",
              "id",
              "source",
              "status",
              "versionedPackages",
              "warnings",
              "warningsTruncated"
            ]
          },
          {
            "type": "object",
            "properties": {
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "diagnostic": {
                "type": "string"
              },
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "previousVersionedPackages": {
                "description": "The last successfully published reachable-version snapshot, if any.\n\nA failed re-elaboration does not replace the prior snapshot, so callers can continue to inspect it while acting on `diagnostic`.",
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/VersionedPackage"
                }
              },
              "status": {
                "type": "string",
                "enum": [
                  "failed"
                ]
              }
            },
            "required": [
              "createdAt",
              "diagnostic",
              "id",
              "previousVersionedPackages",
              "status"
            ]
          }
        ]
      },
      "PackageSourceWarning": {
        "type": "object",
        "properties": {
          "declaredByPurl": {
            "nullable": true,
            "type": "string"
          },
          "dependencyName": {
            "type": "string"
          },
          "message": {
            "description": "A fixed explanation that does not include untrusted registry content.",
            "type": "string"
          },
          "specificationKind": {
            "type": "string"
          }
        },
        "required": [
          "dependencyName",
          "message",
          "specificationKind"
        ]
      },
      "PostAssessmentBody": {
        "type": "object",
        "properties": {
          "affectedPurl": {
            "type": "string"
          },
          "targetPurl": {
            "type": "string"
          }
        },
        "required": [
          "affectedPurl",
          "targetPurl"
        ],
        "additionalProperties": false
      },
      "PostAssessmentResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id"
        ]
      },
      "PostPackageSourceResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id"
        ]
      },
      "PostUpgradeAssessmentBody": {
        "description": "Input for an asynchronous NPM upgrade-safety assessment.",
        "type": "object",
        "properties": {
          "candidateVersion": {
            "nullable": true,
            "type": "string"
          },
          "currentVersion": {
            "type": "string"
          },
          "packageName": {
            "type": "string"
          },
          "trigger": {
            "$ref": "#/components/schemas/UpgradeAssessmentTrigger"
          }
        },
        "required": [
          "currentVersion",
          "packageName",
          "trigger"
        ]
      },
      "PostUpgradeAssessmentResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id"
        ]
      },
      "UpgradeAssessmentCandidate": {
        "type": "object",
        "properties": {
          "caveats": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verdict": {
            "$ref": "#/components/schemas/UpgradeAssessmentVerdict"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "caveats",
          "verdict",
          "version"
        ]
      },
      "UpgradeAssessmentConfidence": {
        "type": "string",
        "enum": [
          "high",
          "medium",
          "low",
          "unknown"
        ]
      },
      "UpgradeAssessmentDependencyDelta": {
        "type": "object",
        "properties": {
          "added": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "changed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "removed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "added",
          "changed",
          "removed"
        ]
      },
      "UpgradeAssessmentFinding": {
        "type": "object",
        "properties": {
          "effect": {
            "type": "string"
          },
          "evidenceLinks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "effect",
          "evidenceLinks",
          "summary"
        ]
      },
      "UpgradeAssessmentInput": {
        "type": "object",
        "properties": {
          "candidateVersion": {
            "nullable": true,
            "type": "string"
          },
          "currentVersion": {
            "type": "string"
          },
          "ecosystem": {
            "$ref": "#/components/schemas/PackageSourceEcosystem"
          },
          "packageName": {
            "type": "string"
          },
          "trigger": {
            "$ref": "#/components/schemas/UpgradeAssessmentTrigger"
          }
        },
        "required": [
          "currentVersion",
          "ecosystem",
          "packageName",
          "trigger"
        ]
      },
      "UpgradeAssessmentReport": {
        "type": "object",
        "properties": {
          "candidateVersions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UpgradeAssessmentCandidate"
            }
          },
          "caveats": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "$ref": "#/components/schemas/UpgradeAssessmentConfidence"
          },
          "dependencyDelta": {
            "$ref": "#/components/schemas/UpgradeAssessmentDependencyDelta"
          },
          "evidenceLinks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "input": {
            "$ref": "#/components/schemas/UpgradeAssessmentInput"
          },
          "supplyChainFindings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UpgradeAssessmentFinding"
            }
          },
          "verdict": {
            "$ref": "#/components/schemas/UpgradeAssessmentVerdict"
          },
          "vulnerabilityContext": {
            "$ref": "#/components/schemas/UpgradeAssessmentVulnerabilityContext"
          }
        },
        "required": [
          "candidateVersions",
          "caveats",
          "confidence",
          "dependencyDelta",
          "evidenceLinks",
          "input",
          "supplyChainFindings",
          "verdict",
          "vulnerabilityContext"
        ]
      },
      "UpgradeAssessmentStatus": {
        "description": "The durable lifecycle state of an upgrade assessment.",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "input": {
                "$ref": "#/components/schemas/UpgradeAssessmentInput"
              },
              "status": {
                "type": "string",
                "enum": [
                  "processing"
                ]
              }
            },
            "required": [
              "createdAt",
              "id",
              "input",
              "status"
            ]
          },
          {
            "type": "object",
            "properties": {
              "completedAt": {
                "type": "string",
                "format": "date-time"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "report": {
                "$ref": "#/components/schemas/UpgradeAssessmentReport"
              },
              "status": {
                "type": "string",
                "enum": [
                  "completed"
                ]
              }
            },
            "required": [
              "completedAt",
              "createdAt",
              "id",
              "report",
              "status"
            ]
          },
          {
            "type": "object",
            "properties": {
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "error": {
                "type": "string"
              },
              "failedAt": {
                "type": "string",
