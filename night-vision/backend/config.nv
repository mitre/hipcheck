# Configuration file for `nv-server`
#
# This uses a very simple syntax inspired by the configuration for Ghostty.
# Each configuration line is a key-value pair separated by an equals sign.
# Values can be quoted-wrapped if you want.
#
# `server-address` and `database-connection` are required. Other fields are
# optional.
#
# See `src/config.rs` for a list of supported keys and their default values.

# The address to bind the Night Vision server to.
server-address = "127.0.0.1:8080"

# The connection string for the database.
database-connection = "postgres://localhost:5432/nv"
