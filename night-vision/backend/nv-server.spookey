# Configuration file for `nv-server`
#
# This uses a very simple syntax inspired by the configuration for Ghostty.
# Each configuration line is a key-value pair separated by an equals sign.
# Values can be quoted-wrapped if you want. Values are optional, and if not
# provided the key will use the default value.
#
# `server-address` is required. Exactly one of `database-connection` or
# `database-connection-file` is required.

# The address to bind the Night Vision server to.
server-address = "127.0.0.1:8080"

# The connection string for the local Docker Compose database. The setup script
# generates this ignored file with the local database credentials.
database-connection-file = "../.secrets/local-development-database-url"

# The destination path to write the OpenAPI Definition file.
# If this is a relative directory, it will be treated as relative to the rust
# workspace directory where nv-server was compiled.
openapi-dest-path = "openapi/nv-server-openapi.json"

# The URL from which the Known Exploited Vulnerabilities (KEV) Catalog
# should be downloaded.
#
# Default: "https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json"
kev-url =

# The interval in milliseconds between KEV Catalog sync runs.
# Must be greater than 0.
#
# Default: 3600000 (1 hour)
kev-refresh-interval =

# The maximum size in bytes of a KEV Catalog response body.
# Must be greater than 0.
#
# Default: 16777216 (16 MiB)
kev-response-body-max-bytes =

# Maximum size in bytes for the request body.
#
# Default: 1024
http-request-body-max-bytes =

# The default behavior for handling early client disconnects.
# Can be "cancel" or "continue".
# "cancel" means endpoint handlers are dropped when the client disconnects.
# "continue" means endpoint handlers run to completion anyway.
#
# Default: "continue"
http-early-disconnect-behavior =

# Maximum size in bytes of the package.json contents submitted to the
# package-source endpoint. Must be greater than 0 and must not exceed 1048576.
#
# Default: 1048576 (1 MiB)
package-source-contents-max-bytes =

# Timeout in milliseconds for accepting one package-source submission. Must be
# greater than 0.
#
# Default: 5000
package-source-request-timeout =

# Maximum number of package-source submissions accepted concurrently per
# server process. Must be greater than 0.
#
# Default: 4
package-source-max-concurrency =

# The maximum number of connections to the database.
#
# Default: 100
database-max-connections =

# The minimum number of connections to the database.
#
# Default: 0
database-min-connections =

# Timeout in milliseconds for establishing a connection to the database.
#
# Default: (no timeout)
database-connect-timeout =

# Timeout in milliseconds for idle connections to the database.
#
# Default: (no timeout)
database-idle-timeout =

# Timeout in milliseconds for acquiring a connection from the database.
#
# Default: (no timeout)
database-acquire-timeout =

# Maximum total lifetime in milliseconds for a connection to the database.
#
# Default: (no timeout)
database-max-lifetime =

# The Git repository URL for CVE List data.
#
# Default: https://github.com/CVEProject/cvelistV5.git
cve-list-repository-url =

# The Git repository ref for CVE List data.
#
# Default: main
cve-list-repository-ref =

# The interval in milliseconds between CVE List sync attempts.
#
# Default: 420000
cve-list-sync-interval =

# The timeout in milliseconds for one CVE List sync attempt.
#
# Default: 3600000
cve-list-sync-timeout =

# The timeout in milliseconds for the first CVE List sync attempt.
#
# Default: 14400000
cve-list-first-sync-timeout =

# The local checkout path for the CVE List repository cache.
cve-list-checkout-path = "target/cve-list/cvelistV5"

# The maximum number of CVE List records to parse concurrently.
#
# Default: auto, based on async worker threads and async blocking threads,
# capped at 32.
cve-list-parse-concurrency =

# The maximum number of CVE List records to write in one database batch.
#
# Default: 500
cve-list-write-batch-size =

# The maximum size in bytes for one CVE List record blob.
#
# Default: 5242880
cve-record-max-bytes =

# The number of parsed CVE List records to buffer before database writes.
#
# Default: auto, based on cve-list-parse-concurrency and
# cve-list-write-batch-size, capped at 1024.
cve-list-write-channel-size =

# The NPM registry base URL used for package-source elaboration.
#
# Default: https://registry.npmjs.org/
npm-registry-url =

# The number of concurrent package elaboration workers.
#
# Default: auto, four times async worker threads, between 4 and 32.
package-elaboration-worker-concurrency =

# The bounded package elaboration work queue capacity.
#
# Default: four times package-elaboration-worker-concurrency.
package-elaboration-work-queue-capacity =

# The maximum number of package-source elaborations that may run at once.
#
# Requests beyond this capacity receive a retryable service-unavailable response.
# Default: 4.
package-elaboration-max-concurrent-runs =

# The maximum NPM packument response size in bytes.
#
# Default: 5242880
package-elaboration-max-packument-bytes =

# The maximum time allowed for one NPM registry request in milliseconds.
#
# Default: 30000
package-elaboration-request-timeout =

# The maximum time allowed for an entire package elaboration run in milliseconds.
#
# Default: 300000
package-elaboration-total-run-timeout =

# The maximum concrete package versions in one elaboration result.
#
# Default: 10000
package-elaboration-max-packages =

# The maximum dependency edges in one elaboration result.
#
# Default: 100000
package-elaboration-max-edges =

# The maximum not-yet-dispatched dependency work items in one elaboration run.
#
# Default: 100000
package-elaboration-max-queued-work =

# The maximum acyclic derivation paths in one elaboration result.
#
# Default: 100000
package-elaboration-max-derivations =

# Hipcheck assessments run the bundled policy with this bounded process configuration.
# Default concurrency: 1.
hipcheck-bin-path =
hipcheck-policy-path =
hipcheck-exec-config-path =
hipcheck-working-dir =
hipcheck-cache-dir =
hipcheck-data-dir =
hipcheck-timeout =
hipcheck-stdout-max-bytes =
hipcheck-stderr-max-bytes =
hipcheck-json-max-bytes =
hipcheck-max-concurrent-runs =

# The number of async worker threads to use for handling requests.
#
# Default: (the number of CPU cores available on the system)
async-worker-threads =

# The size in bytes for stacks available to worker tasks.
#
# Default: 2000000
async-worker-thread-stack-size =

# The maximum number of blocking threads in the async runtime.
#
# Default: 512
async-max-blocking-threads =

# The number of milliseconds to keep blocking threads alive after they finish.
#
# Default: 10000
async-blocking-thread-keep-alive =

# The number of scheduler ticks between polls to the global task queue.
#
# While each thread allocated for a worker maintains a local task queue, they
# periodically also pull from the global task queue. This setting determines how
# often that pull happens.
#
# Default: 31
async-global-queue-interval =

# The number of scheduler ticks between event polling.
#
# Default: 61
async-event-interval =
